// Full application test-channel package. The device-debug package is a separate product.
// All packaging resources and platform permissions come from electron-builder.json5.
{
  "extends": "./electron-builder.json5",
  "appId": "com.diamondfsd.lunaaicut.test",
  "productName": "Luna AI Cut 测试版",
  "directories": {
    "output": "release-test/${version}"
  },
  "mac": {
    "artifactName": "LunaAICut-Test-Mac-${version}-Installer-${arch}.${ext}"
  },
  "win": {
    "artifactName": "LunaAICut-Test-Windows-${version}-Setup-${arch}.${ext}"
  }
}
