{
  "name": "@luna/editor-sdk",
  "version": "0.1.0",
  "description": "Runtime-neutral JavaScript SDK contracts for Luna editing applications",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:protocol": "pnpm run build && node --test tests/*.test.mjs"
  }
}
