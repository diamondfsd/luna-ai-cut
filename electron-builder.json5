// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.diamondfsd.lunaaicut",
  "asar": true,
  "asarUnpack": [],
  "afterPack": "scripts/after-pack-adhoc.mjs",
  "productName": "Luna AI Cut",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "icon.png"
    },
    {
      "from": "build/tray-template.png",
      "to": "tray-template.png"
    },
    {
      "from": "luna_mock_server",
      "to": "luna_mock_server",
      "filter": ["**/*"]
    },
    {
      "from": "dji_mock_server",
      "to": "dji_mock_server",
      "filter": ["**/*"]
    },
    {
      "from": "resources/ffmpeg",
      "to": "ffmpeg",
      "filter": ["**/*"]
    },
    {
      "from": "resources/dolby-vision",
      "to": "dolby-vision",
      "filter": ["dovi_tool", "dovi_tool.exe", "mp4mux", "mp4mux.exe"]
    },
    {
      "from": "luna-render-core",
      "to": "luna-render-core",
      "filter": ["luna-render-core.node", "sam-segmentation-worker", "sam-segmentation-worker.exe", "semantic-segmentation-worker", "semantic-segmentation-worker.exe", "specialized-segmentation-worker", "specialized-segmentation-worker.exe", "luna-inpaint-worker", "luna-inpaint-worker.exe", "luna-asr-worker", "luna-asr-worker.exe", "luna-punctuation-worker", "luna-punctuation-worker.exe", "*.dylib", "*.dll", "*.so*", "DXC-LICENSE-*.txt"]
    },
    {
      "from": "src/assets/watermark",
      "to": "watermark",
      "filter": ["**/*.png"]
    },
    {
      "from": "src/assets/logos",
      "to": "logos",
      "filter": ["**/*.png"]
    },
    {
      "from": ".",
      "to": ".",
      "filter": ["RELEASE_NOTES_*.md"]
    },
    {
      "from": "old-release-log",
      "to": "old-release-log",
      "filter": ["RELEASE_NOTES_*.md"]
    },
    {
      "from": "electron/platform/macos",
      "to": "swift",
      "filter": ["*.swift"]
    },
    {
      "from": "electron/platform/windows",
      "to": "native",
      "filter": ["*.ps1"]
    }
  ],
  "mac": {
    "icon": "build/icon.icns",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "LunaAICut-Mac-${version}-Installer-${arch}.${ext}",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "hardenedRuntime": true,
    "extraResources": [
      {
        "from": "node_modules/7zip-bin/mac/${arch}/7za",
        "to": "tools/7za"
      },
      {
        "from": "resources/dji-ble-helper",
        "to": "dji-ble-helper",
        "filter": ["DjiCoreBluetoothTransport.app/**/*"]
      }
    ],
    "extendInfo": {
      "NSLocalNetworkUsageDescription": "Luna AI Cut 需要访问本地网络来连接相机并读取素材",
      "NSLocationUsageDescription": "Luna AI Cut 需要扫描附近 Wi-Fi，以自动连接相机网络",
      "NSBluetoothAlwaysUsageDescription": "Luna AI Cut 需要通过 Bluetooth 读取 DJI 相机的 Wi-Fi 连接信息",
      "NSBluetoothPeripheralUsageDescription": "Luna AI Cut 需要通过 Bluetooth 读取 DJI 相机的 Wi-Fi 连接信息"
    }
  },
  "win": {
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "tools/7za.exe"
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "LunaAICut-Windows-${version}-Setup-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "icon": "build/icon.png",
    "target": [
      "AppImage"
    ],
    "artifactName": "LunaAICut-Linux-${version}.${ext}"
  }
}
