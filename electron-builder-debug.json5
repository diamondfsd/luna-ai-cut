// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.diamondfsd.luna-device-debug",
  "asar": true,
  "asarUnpack": [],
  "afterPack": "scripts/after-pack-adhoc.mjs",
  "productName": "Luna Device Debug",
  "directories": {
    "output": "release-debug",
    "buildResources": "build-debug"
  },
  "files": [
    "dist-debug",
    "dist-electron"
  ],
  "extraResources": [
    {
      "from": "resources/dolby-vision",
      "to": "dolby-vision",
      "filter": ["dovi_tool", "dovi_tool.exe", "mp4mux", "mp4mux.exe"]
    },
    {
      "from": "luna-render-core/luna-render-core.node",
      "to": "luna-render-core/luna-render-core.node"
    },
    {
      "from": "luna-render-core",
      "to": "luna-render-core",
      "filter": ["sam-segmentation-worker", "sam-segmentation-worker.exe", "semantic-segmentation-worker", "semantic-segmentation-worker.exe", "specialized-segmentation-worker", "specialized-segmentation-worker.exe", "luna-inpaint-worker", "luna-inpaint-worker.exe", "*.dylib", "*.dll", "*.so*"]
    },
    {
      "from": "src/assets/logos",
      "to": "logos",
      "filter": ["**/*.png"]
    }
  ],
  "mac": {
    "icon": "build-debug/icon.icns",
    // electron-builder 不签名；afterPack 统一执行 Ad Hoc 签名。
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "LunaDeviceDebug-Mac-${version}-${arch}.${ext}",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "hardenedRuntime": true,
    "extraResources": [
      {
        "from": "node_modules/7zip-bin/mac/${arch}/7za",
        "to": "tools/7za"
      }
    ],
    "extendInfo": {
      "NSLocalNetworkUsageDescription": "Luna AI Cut 需要访问本地网络来连接 Insta360 相机（Luna / Go Ultra）"
    }
  },
  "win": {
    "icon": "build-debug/icon.ico",
    "extraResources": [
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "tools/7za.exe"
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "LunaDeviceDebug-Windows-${version}-Setup-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
